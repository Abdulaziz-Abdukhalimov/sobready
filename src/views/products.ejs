<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/products.css" />

<body>
  <div class="products-container">
    <div class="navigation-menu">
      <ul class="nav justify-content-center">
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link active" href="/admin/">Home</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/product/all"
            ><i class="fa-solid fa-bars"></i> </i>Menu</a
          >
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/user/all"> <i class="fa-solid fa-users"></i> Users</a>
        </li>
        <li
          class="nav-item"
          style="cursor: pointer"
          onclick="return confirm('Do you want to logout?')"
        >
          <a class="nav-link" href="/admin/logout"> <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout</a>
        </li>
      </ul>
    </div>
        <div class="table-container">
          <div class="table-header">
            <h3>Product Stock</h3>
            <button type="button" class="add-btn" id="addProductBtn"> + Add new Product</button>
          </div>

         <div class="product-table-container" >
  <table class="product-table">
    <thead>
      <tr>
        <th>Image</th>
        <th>Product Name</th>
        <th>Category</th>
        <th>Price</th>
        <th>Piece</th>
        <th>Available Volume</th>
        <th>Product Status</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% products.map(function (product) { %>
      <tr>
        <td>
          <img src="/<%= product.productImages[0] %>" class="product-img" />
        </td>
        <td><%= product.productName %></td>
        <td><%= product.productType %></td>
        <td>$<%= product.productPrice.toFixed(2) %></td>
        <td><%= product.productStock %></td>
        <td>
         <%= Array.isArray(product.productVolume) && product.productVolume.length
            ? product.productVolume.map(function(v){ return v + " ml"; }).join(", ")
           : (product.productVolume ? product.productVolume + " ml" : "—") %>
        </td>
        <td>
                <select
                  class="spec-select new-product-status"
                  id="<%= product._id %>"
                >
                  <option value="ACTIVE" <%= product.productStatus === 'ACTIVE'? 'selected': '' %> >Active</option>
                  <option value="INACTIVE" <%= product.productStatus === 'INACTIVE'? 'selected': '' %> >Inactive</option>
                  <option value="OUTOFSTOCK" <%= product.productStatus === 'OUTOFSTOCK'? 'selected': '' %> >Outof stock</option>
                </select>
              </td>
        <td class="actions">
          <button class="edit-btn">
            <i class="fa-solid fa-edit"></i>
          </button>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>

  <!-- Add Product Form (hidden by default) -->
<div class="add-product-form-container" style="display: none;">
  <h3>Add New Product</h3>
  <form id="addProductForm" action="/admin/product/create" method="POST" enctype="multipart/form-data" onsubmit="validateForm()" class="newp-container">
    <div class="form-group1">
      <label>Product Name:</label>
      <input type="text" name="productName" required />
      <label>Product Brand:</label>
      <input type="text" name="productBrand" required />
    </div>
    <div class="form-group">
      <label>Category:</label>
       <select name="productType">
        <option value="EAU_DE_PARFUM" selected>Eau_de_parfum</option>
        <option value="EAU_DE_TOILETTE" >Eau_de_toilette</option>
        <option value="PARFUM" >Parfum</option>
        <option value="BODY_SPRAY" >Body Spray</option>
       </select>
    </div>
     <div class="form-group">
      <label>Fragrance:</label>
       <select name="productFragrance">
        <option value="FLORAL" selected>Floral</option>
        <option value="WOODY" >Woody</option>
        <option value="CITRUS" >Citrus</option>
        <option value="ORIENTAL" >Orinental</option>
        <option value="AROMATIC" >Aromatic</option>
        <option value="FRESH" >Fresh</option>
       </select>
    </div>
    <div class="form-group">
      <label>Price ($):</label>
      <input type="number" step="0.01" name="productPrice" required />
    </div>
    <div class="form-group">
      <label>Stock (pieces):</label>
      <input type="number" name="productStock" required />
    </div>
    <div class="form-group">
      <label>Volume (ml, comma separated):</label>
      <!-- <input type="text" name="productVolume" placeholder="e.g. 250, 500" /> -->
       <select name="productVolume" class="selects">
        <option value="30" selected>30 ml</option>
        <option value="50" >50 ml</option>
        <option value="100" >100 ml</option>
       </select>
    </div>
       <div class="long-input">
            <label>Product Description</label>
            <textarea name="productDesc" class="product-desc"></textarea>
          </div>
       <div class="img-frame">
            <label>Product Images</label>
            <div class="media-frame">
              <div class="upload-img-box">
                <img src="/img/upload-icon.png" class="1" id="image-section-1" />
                <input
                  type="file"
                  id="file"
                  name="productImages"
                  class="image-one"
                  onchange="previewFileHandler(this,1)"
                />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload-icon.png" class="2" id="image-section-2" />
                <input
                  type="file"
                  id="file"
                  name="productImages"
                  class="image-two"
                  onchange="previewFileHandler(this,2)"
                />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload-icon.png" class="3" id="image-section-3" />
                <input
                  type="file"
                  id="file"
                  name="productImages"
                  class="image-three"
                  onchange="previewFileHandler(this,3)"
                />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload-icon.png" class="4" id="image-section-4" />
                <input
                  type="file"
                  id="file"
                  name="productImages"
                  class="image-four"
                  onchange="previewFileHandler(this,4)"
                />
              </div>
              <input name="restaurantIid" class="restaurant-id" hidden />
            </div>
          </div>
    <div class="form-buttons">
      <button type="submit" class="save-btn">Save</button>
      <button type="button" class="cancel-btn">Cancel</button>
    </div>
  </form>
</div>

</div>
   </div>

  </div>

  <script type="text/javascript" src="/js/products.js"></script>
</body>

<%- include('includes/footer') %>
