<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/home.css" />
<body>
  <div class="home-container">
    <div class="brand-logo">
      <span class="sob">SOB</span>
      <span class="ready">READY</span>
    </div>

    <div class="navigation-menu">
      <ul class="nav justify-content-center">
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link active" href="/admin">Home</a>
        </li>
        <% if(!member) { %>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/signup">Signup</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/login">Login</a>
        </li>
        <% } else { %>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/product/all"
            ><i class="fa-solid fa-bars"></i> </i>Menu</a
          >
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/user/all"> <i class="fa-solid fa-users"></i> Users</a>
        </li>
        <li
          class="nav-item"
          style="cursor: pointer"
          onclick="return confirm('Do you want to logout?')"
        >
          <a class="nav-link" href="/admin/logout"> <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout</a>
        </li>
        <% } %>
      </ul>
    </div>

     <div class="dashboard-container">
    <h1>Admin Dashboard</h1>

    <!-- KPI CARDS -->


    <!-- TOP PRODUCTS + RECENT ORDERS -->
    <div class="tables-container">
      <div class="table-section">
        <h3>Top Products</h3>

      </div>

      <div class="table-section">
        <h3>Recent Orders</h3>
        <table>
          <thead>
            <tr>
              <th>User</th>
              <th>Date</th>
              <th>Amount</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
              <tr>
                <td>UserName</td>
                <td>order created at</td>
                <td>order total amount</td>
                <td>Order status</td>
              </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- QUICK ACTIONS -->
    <div class="quick-actions">
      <button >➕ Add Product</button>
      <button>📦 Manage Orders</button>
      <button >👥 Manage Users</button>
    </div>
  </div>
</body>
  <%- include('includes/footer') %>