<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/signup.css" />

<body>
  <body>
    <div class="auth-container">
      <!-- Right Side -->
      <div class="auth-right">
        <h1>Sign in</h1>
        <div class="social-icons">
          <a href="#"><span>f</span></a>
          <a href="#"><span>G+</span></a>
          <a href="#"><span>in</span></a>
        </div>
        <p>or use your email for registration</p>
        <form action="/admin/login" method="post">
          <input
            type="text"
            name="memberNick"
            class="member-nick"
            placeholder="Name"
            value=""
            required
          />
          <input
            type="password"
            name="memberPassword"
            class="member-password"
            placeholder="Password"
            value=""
            required
          />
          <button type="submit" class="btn-solid" id="signup-btn" name="login">
            SIGN IN
          </button>
        </form>
      </div>
      <!-- Left Side -->
      <div class="auth-left">
        <h1>Hello!</h1>
        <p>Not registered yet ?</p>
        <button class="btn-outline" id="login-btn">
          <a href="/admin/signup">SIGN UP</a>
        </button>
        <div><a href="/admin" style="color: aliceblue">Home</a></div>
      </div>
    </div>
  </body>
</body>
<%- include('includes/footer') %>
